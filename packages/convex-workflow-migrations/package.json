{
  "name": "@dev-marzahn/convex-workflow-migrations",
  "version": "100.0.0",
  "description": "Temporal-style patched() for @convex-dev/workflow: change a released workflow without failing the runs already in flight.",
  "keywords": [
    "convex",
    "convex-component",
    "convex-dev",
    "durable-execution",
    "versioning",
    "workflow"
  ],
  "homepage": "https://github.com/dev-marzahn/convex-workflow-patches#readme",
  "bugs": {
    "url": "https://github.com/dev-marzahn/convex-workflow-patches/issues"
  },
  "license": "MPL-2.0 AND Apache-2.0",
  "author": "Leon Marzahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-marzahn/convex-workflow-patches.git",
    "directory": "packages/convex-workflow-migrations"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"const fs = require('fs'); fs.copyFileSync('src/vendor/workflow/LICENSE', 'dist/vendor/workflow/LICENSE'); fs.chmodSync('dist/cli.js', 0o755)\"",
    "test": "vp test",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../../' + f, f)\"",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "async-channel": "catalog:"
  },
  "devDependencies": {
    "@convex-dev/workflow": "catalog:",
    "@convex-dev/workpool": "catalog:",
    "@edge-runtime/vm": "catalog:",
    "@types/node": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "catalog:",
    "convex-test": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@convex-dev/workflow": "0.4.10",
    "@convex-dev/workpool": "^0.4.4",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.127",
    "convex-test": ">=0.0.60"
  },
  "peerDependenciesMeta": {
    "convex-test": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "convex-release": {
    "predeploy": "./dist/predeploy.js"
  }
}
